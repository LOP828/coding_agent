{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "node_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "requirement_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^R-[0-9]{3,}$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "origin": {
      "enum": [
        "EXPLICIT",
        "DERIVED",
        "UNSOURCED"
      ]
    },
    "derivation_reason": {
      "type": "string"
    },
    "allowed_change_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "properties": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "requirement_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^R-[0-9]{3,}$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "origin": {
            "enum": [
              "EXPLICIT",
              "DERIVED",
              "UNSOURCED"
            ]
          },
          "derivation_reason": {
            "type": "string"
          }
        },
        "required": [
          "statement",
          "requirement_refs",
          "origin",
          "derivation_reason"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "node_id",
    "title",
    "requirement_refs",
    "origin",
    "derivation_reason",
    "allowed_change_paths",
    "properties"
  ]
}
